# Copy to .env and replace local placeholders. Never commit .env.
POSTGRES_DB=quiz_examination
POSTGRES_USER=quiz_app
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=55433
# Cổng website khi chạy bằng Docker (docker compose up). Đổi nếu 8000 đang bận.
WEB_PORT=8000
# Mật khẩu cho 6 tài khoản demo (chỉ dùng trên máy mình): ít nhất 8 ký tự, có cả chữ và số,
# khác POSTGRES_PASSWORD.
DEMO_PASSWORD=

# Django. Tạo SECRET_KEY bằng lệnh:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# True khi chạy trên máy mình; False khi đưa lên máy chủ.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: expose behind an HTTPS proxy/tunnel
# BEHIND_PROXY=true
# CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com
